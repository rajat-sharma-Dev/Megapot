# Rally Vault — local config
#
#   cp .env.example .env.local && npm run dev
#
# These defaults are safe: they target Base Sepolia testnet and never broadcast
# a transaction. Nothing here needs an account, an API key, or any funds.

# ── Network ──────────────────────────────────────────────────────────────────
# 'testnet' (Base Sepolia) or 'mainnet' (Base). Testnet uses valueless USDC.
NEXT_PUBLIC_MEGAPOT_NETWORK=testnet

# Optional. Falls back to the public endpoint for the selected network
# (https://sepolia.base.org / https://mainnet.base.org). Set a private RPC if
# you hit rate limits.
# NEXT_PUBLIC_RPC_URL=

# ── Purchases ────────────────────────────────────────────────────────────────
# true  → build and SIMULATE every purchase against live chain state, then stop.
#         Malformed tickets and bad referral splits still revert exactly as they
#         would on-chain; only an unfunded treasury is waved through, with an
#         obviously-synthetic 0xdd1f… hash.
# false → broadcast for real. Requires a funded treasury below.
MEGAPOT_DRY_RUN=true

# The wallet that PAYS for tickets. Server-only — never exposed to the browser.
#
# Leave this unset to play: racing, scoring and the whole daily ladder work
# without it. It is only needed when a vault day closes and actually buys
# tickets, and even then a missing key is caught and recorded per-player rather
# than breaking the payout.
#
# To exercise the purchase path, put any throwaway testnet key here — Anvil's
# test account #0 works and is publicly known:
#   TREASURY_PRIVATE_KEY=0xac0974...ff80   (see hardhat/anvil docs for the full key)
# Generate your own instead with:  openssl rand -hex 32
#
# TREASURY_PRIVATE_KEY=

# ── Referrals (optional) ─────────────────────────────────────────────────────
# Megapot pays 10% of ticket price + 10% of player winnings to this address.
# Leave unset to pass empty referral arrays.
# NEXT_PUBLIC_REFERRER_ADDRESS=0x0000000000000000000000000000000000000000

# ── Data API (optional) ──────────────────────────────────────────────────────
# api.megapot.io allows 120 req/min anonymous, 300 with a key.
# MEGAPOT_API_KEY=

# ── Free play (optional) ─────────────────────────────────────────────────────
# Every player is topped up to 25 entries once per vault day (17:00 UTC reset).
# The wallet this game generates on first visit has no funds and no way to get
# any, so without the grant there is nothing to play. Set to false to require
# real deposits instead.
# RALLY_FREE_PLAY=true

# ── Storage (optional) ───────────────────────────────────────────────────────
# Where the file-backed store writes. Defaults to ./.data
# RALLY_DATA_DIR=
