# Rally Vault — local config
#
#   cp .env.example .env.local && npm run dev
#
# These defaults target Base Sepolia testnet and never broadcast a ticket
# purchase. Nothing here needs an account or an API key to get the game running.

# ── Network ──────────────────────────────────────────────────────────────────
# 'testnet' (Base Sepolia) or 'mainnet' (Base). Testnet uses valueless USDC.
NEXT_PUBLIC_MEGAPOT_NETWORK=testnet

# Two RPC endpoints, and the split is deliberate.
#
# RPC_URL has no NEXT_PUBLIC_ prefix, so it never reaches the browser. It is used
# for everything server-side: chain reads, deposit verification, ticket
# purchases. Put your private provider key here.
#
# NEXT_PUBLIC_RPC_URL is shipped to every visitor by definition — the browser
# needs an endpoint for wagmi's own reads. Use a key restricted by domain in your
# provider's dashboard, or leave it unset to fall back to the public endpoint
# (rate limited, but it leaks nothing).
#
# Both fall back to https://sepolia.base.org / https://mainnet.base.org.
# RPC_URL=
# NEXT_PUBLIC_RPC_URL=

# ── The treasury ─────────────────────────────────────────────────────────────
# One wallet does two jobs: it is the address players DEPOSIT to, and the key
# that PAYS for Megapot tickets. Server-only — never exposed to the browser.
#
# Without it the game still runs, but deposits are switched off (there is
# nowhere to send USDC) and no ticket can be bought.
#
# Generate a throwaway testnet key with:  openssl rand -hex 32
# Then fund it with Base Sepolia ETH (for gas) and testnet USDC.
#
# TREASURY_PRIVATE_KEY=
#
# Read-only alternative: accept deposits and show balances without holding a
# spending key on the server. Withdrawals and ticket purchases will not work.
# TREASURY_ADDRESS=

# ── Ticket purchases ─────────────────────────────────────────────────────────
# true  → build and SIMULATE every ticket purchase against live chain state,
#         then stop. Malformed tickets and bad referral splits still revert
#         exactly as they would on-chain; only an unfunded treasury is waved
#         through, with an obviously-synthetic 0xdd1f… hash.
# false → broadcast for real. Requires a funded treasury above.
#
# NOTE: this governs TICKET PURCHASES ONLY. Deposits and withdrawals are always
# real chain operations — the alternative is accepting a real deposit and
# simulating the way back out, which takes people's money.
MEGAPOT_DRY_RUN=true

# ── The house float ──────────────────────────────────────────────────────────
# The bankroll that stakes empty seats, in USDC base units (6dp).
#
# House seats are not a subsidy. The house stakes an entry fee like everyone
# else and keeps the pot when one of its racers outscores every human, so a solo
# player is genuinely playing against something. The float can run dry, and when
# it does the house seats race for nothing and the pot is only what humans put
# in. Seeded once, on a fresh database.
# RALLY_HOUSE_FLOAT=2000000

# Set to false to stop house seats staking entirely. Pots then contain only
# human stakes, which means a solo race has nothing to win.
# RALLY_HOUSE_STAKE=true

# ── Matchmaking timing ───────────────────────────────────────────────────────
# How long an under-filled lobby waits for more humans before the house takes
# the empty seats. Short on purpose — a player who clicked "race" wants to race.
# RALLY_FILL_WINDOW_MS=15000

# How long a locked lobby waits for every human to actually drive before it
# settles without them. A seat that never drives scores zero and forfeits its
# stake, which is what stops one player wandering off from holding four other
# people's money hostage.
# RALLY_SUBMIT_WINDOW_MS=300000

# ── Referrals ────────────────────────────────────────────────────────────────
# Megapot pays a share of ticket price AND a share of a referred player's
# winnings to whoever is named as referrer on a purchase. Both rates are live
# per-drawing state — currently 10% and 10%, readable at GET /api/admin/referral.
#
# This is how an integration like this makes money. Leave it unset and every
# purchase passes empty referral arrays and earns nothing.
#
# Defaults to the treasury address when unset but a treasury key exists.
# NEXT_PUBLIC_REFERRER_ADDRESS=0x0000000000000000000000000000000000000000

# Shared secret for POST /api/admin/referral, which sweeps accrued referral fees
# to the treasury by calling claimReferralFees(). Unset disables the route.
#
# The contract only ever pays fees to the address that earned them, so the worst
# an attacker could do here is spend our gas sending us our own money — the
# secret exists to stop that being free, not to protect the funds.
#
# Note claimReferralFees() pays msg.sender, so the treasury key must BE the
# referrer address for the sweep to work.
# RALLY_ADMIN_SECRET=

# ── Data API (optional) ──────────────────────────────────────────────────────
# api.megapot.io allows 120 req/min anonymous, 300 with a key.
# MEGAPOT_API_KEY=

# ── Dev faucet (optional, OFF by default) ────────────────────────────────────
# Grants play credits without a real deposit. Exists for the end-to-end suite,
# which cannot source testnet USDC on demand, and for a demo where a judge
# should be racing in one click rather than hunting for a faucet.
#
# Refuses to run against mainnet under any setting, and writes a clearly
# labelled ledger row so granted credits are never mistaken for deposited ones.
# An unset variable must never mean "hand out money".
# RALLY_DEV_FAUCET=false

# ── Storage (optional) ───────────────────────────────────────────────────────
# Where the file-backed store writes. Defaults to ./.data
# RALLY_DATA_DIR=
